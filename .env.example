# ---------------------------------------------------------------------------
# BillSaathi AI -- environment variable template
#
# Copy to .env.local and fill in. .env.local is gitignored; this file is NOT.
# PLACEHOLDERS ONLY -- never commit a real key here.
# ---------------------------------------------------------------------------

# --- Supabase -------------------------------------------------------------
# For local development these come from the output of `npm run db:start`
# (i.e. `supabase start`). The local keys are well-known development values
# that ship with the Supabase CLI and are NOT secret.
#
# The hosted project's keys ARE secret and are not needed until the
# deployment milestone.

# Safe to expose to the browser: the URL and the anon key are designed to be
# public, and Row Level Security is what actually protects the data.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-local-anon-key-from-supabase-start

# SERVER-ONLY. This key BYPASSES Row Level Security entirely.
# Never prefix it with NEXT_PUBLIC_, never import it into a client component,
# and never log its value. See src/lib/supabase/admin.ts for the allowlist of
# places it may legitimately be used.
SUPABASE_SERVICE_ROLE_KEY=replace-with-local-service-role-key-from-supabase-start

# --- Application ----------------------------------------------------------
# Used to build absolute URLs for email verification and password reset links.
# Must match the Site URL configured in Supabase Auth settings.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- AI extraction provider ----------------------------------------------
# NOT required for Milestones 1-5. The extraction adapter runs against a mock
# implementation until a real key is configured, so the UI and database
# foundation cost nothing to develop.
#
# EXTRACTION_PROVIDER=mock
# ANTHROPIC_API_KEY=
