{
  "extends": ["next/core-web-vitals", "next/typescript"],
  "rules": {
    "no-restricted-imports": [
      "error",
      {
        "patterns": [
          {
            "group": ["**/lib/supabase/admin", "@/lib/supabase/admin"],
            "message": "The service-role Supabase client BYPASSES Row Level Security, making server-side checks the only remaining control. Import it only from a module on the allowlist documented in src/lib/supabase/admin.ts, and when you do, disable this rule inline with a one-line justification."
          }
        ]
      }
    ],
    "@typescript-eslint/no-unused-vars": [
      "error",
      { "argsIgnorePattern": "^_", "varsIgnorePattern": "^_" }
    ],
    "@typescript-eslint/no-explicit-any": "error",
    "eqeqeq": ["error", "always", { "null": "ignore" }],
    "no-console": ["warn", { "allow": ["warn", "error"] }]
  },
  "overrides": [
    {
      "files": ["src/lib/supabase/admin.ts"],
      "rules": { "no-restricted-imports": "off" }
    }
  ],
  "ignorePatterns": ["node_modules/", ".next/", "out/", "coverage/"]
}
